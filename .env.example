.env.example

# Unifia Workbench v1.0.0 — Example environment file
# Copy to .env.local and fill in your values
# DO NOT commit .env.local or .env (gitignored)

# Unifia API
UNIFIA_API_KEY=unfk_your_api_key_here
UNIFIA_ENDPOINT=https://api.unifia.dev

# Database (optional, defaults to ~/.config/unifia/unifia.db)
UNIFIA_DB_PATH=
UNIFIA_DB_ENCRYPTION_KEY=

# Runtime (opencode | unifia | fake)
UNIFIA_RUNTIME=unifia

# Provider (unifia | openai | anthropic | google)
UNIFIA_PROVIDER=unifia
UNIFIA_PROVIDER_API_KEY=

# Model
UNIFIA_MODEL=unifia-default

# Sandbox (native | docker | wsl2 | lima | auto)
UNIFIA_SANDBOX=auto

# Debug
UNIFIA_DEBUG=false
UNIFIA_LOG_LEVEL=info

# Telemetry (optional)
UNIFIA_LANGFUSE_PUBLIC_KEY=
UNIFIA_LANGFUSE_SECRET_KEY=
UNIFIA_LANGFUSE_HOST=

# Capabilities
UNIFIA_DEFAULT_TRUST=verified
UNIFIA_AUTO_APPROVE_CAPS=

# Security
UNIFIA_DEFAULT_DENY=true
UNIFIA_KILL_SWITCH=false

# Workspace
UNIFIA_DEFAULT_WORKSPACE_PATH=

# Ports
UNIFIA_MCP_PORT=3000
UNIFIA_DASHBOARD_PORT=3030

# SSH (for remote commands)
UNIFIA_SSH_KEY_PATH=
