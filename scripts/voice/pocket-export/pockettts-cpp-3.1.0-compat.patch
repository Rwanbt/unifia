+# UNIFIA PATCH (minimal, 1 symbol) against upstream commit
+# e801e7d6c2692121a39e80ae525cb5265174a495 (2026-03-29, MIT).
+#
+# Upstream imports `pocket_tts.conditioners.base.TokenizedText`, a wrapper type
+# removed upstream in pocket-tts 3.x. In 3.1.0 the text conditioner is
+# `LUTConditioner` (pocket_tts/modules/text_conditioner.py) whose forward is
+# `forward(self, tokens: torch.Tensor) -> torch.Tensor` and which is invoked as
+# `self.flow_lm.conditioner(text_tokens)` (models/tts_model.py:421).
+#
+# Upstream uses the wrapper in two incompatible ways:
+#   - passed straight to the conditioner   -> must BE a tensor
+#   - probed as `prepared.tokens`          -> must EXPOSE `.tokens`
+# A `torch.Tensor` subclass satisfies both without changing any exported
+# graph, tensor name, op set or numerical behaviour.
+#
+# Delta: this block replaces one upstream import line. Nothing else is patched.
+# Verified by the exporter's own fp32 and INT8 PyTorch validation, which must
+# pass or the script exits non-zero.
+# ---------------------------------------------------------------------------
+class TokenizedText(torch.Tensor):
+    """3.x shim for the removed TokenizedText wrapper."""
+
+    @property
+    def tokens(self):
+        return self
+
+
+def _wrap_tokens(tokens):
+    if isinstance(tokens, TokenizedText):
+        return tokens
+    if not isinstance(tokens, torch.Tensor):
+        tokens = torch.as_tensor(tokens, dtype=torch.long)
+    return tokens.as_subclass(TokenizedText)
+
+
+# UNIFIA PATCH (2nd delta): `DEFAULT_LSD_DECODE_STEPS` was renamed upstream to
+# `DEFAULT_SAMPLER_DECODE_STEPS` (value 1 in pocket-tts 3.1.0). Same meaning,
+# new name.
+try:
+    from pocket_tts.default_parameters import DEFAULT_SAMPLER_DECODE_STEPS as DEFAULT_LSD_DECODE_STEPS
+except ImportError:  # older pocket-tts kept the original name
+    from pocket_tts.default_parameters import (
+        DEFAULT_TEMPERATURE, DEFAULT_LSD_DECODE_STEPS,
+        DEFAULT_NOISE_CLAMP, DEFAULT_EOS_THRESHOLD,
+    )
+else:
+    from pocket_tts.default_parameters import (
+        DEFAULT_TEMPERATURE,
+        DEFAULT_NOISE_CLAMP, DEFAULT_EOS_THRESHOLD,
+    )
+
