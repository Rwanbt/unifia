{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unifia.local/parity/aa-calibration.schema.json",
  "title": "A/A Calibration",
  "description": "Natural system variance without probes. 20+ pairs across 4+ Chromium contexts. Envelope(A,A) is the maximum valid observed delta.",
  "type": "object",
  "required": [
    "schemaVersion",
    "environmentLockHash",
    "metrics",
    "pairs",
    "processes",
    "envelopeMethod",
    "envelopeValue"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "environmentLockHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pairs": { "type": "integer", "minimum": 20 },
    "processes": { "type": "integer", "minimum": 4 },
    "observedDeltas": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "envelopeMethod": { "type": "string" },
    "envelopeValue": { "type": "number", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}