{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unifia.local/parity/census-merge-policy.schema.json",
  "title": "Census Merge Policy",
  "description": "Deterministic union of static + preload + post-ready census entries; identity is hashable, conflicts surface.",
  "type": "object",
  "required": ["schemaVersion", "purpose", "identity", "operator", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "purpose": { "type": "string" },
    "identity": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "operator": { "enum": ["deterministic union"] },
    "sources": {
      "type": "array",
      "items": { "enum": ["static", "preload", "post-ready"] }
    },
    "mergeRules": { "type": "array", "items": { "type": "string" } },
    "deterministicRequirements": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "string" },
    "postReady": {
      "type": "object",
      "required": ["executed", "method"],
      "properties": {
        "executed": { "type": "boolean" },
        "rationale": { "type": "string" },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}