{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unifia.local/parity/mutation-spec.schema.json",
  "title": "Mutation Spec",
  "description": "Per-mutation contract: a mutation that is not actually injected is not counted as detected.",
  "type": "object",
  "required": ["schemaVersion", "purpose", "families"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "purpose": { "type": "string" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "inject", "detect", "expectedDetection", "earliestGate", "cleanup"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]{2,}$" },
          "family": { "type": "string" },
          "inject": { "type": "string" },
          "detect": { "type": "string" },
          "expectedDetection": { "enum": ["FAIL", "STOP"] },
          "evidence": { "type": "string" },
          "earliestGate": { "enum": ["G0", "G1", "G2", "G3"] },
          "cleanup": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "string" },
    "earlyGateCoverage": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  }
}