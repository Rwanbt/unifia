!keystore.properties.example
!gradle.properties.template

# Benchmark artefacts (audit §7)
packages/unifia/bench/results/
*.bench.json

# OS / IDE
Thumbs.db
ehthumbs.db

# Alpine rootfs binary archive (generated by build-alpine-rootfs.sh, ~72MB)
packages/mobile/src-tauri/assets/runtime/rootfs.tgz
packages/mobile/src-tauri/gen/android/app/src/main/assets/runtime/rootfs.tgz
packages/mobile/src-tauri/gen/android/app/src/main/assets/runtime/rootfs_version.txt

# Desktop sidecar binary cache (non-canonical path — canonical sidecar lives in
# packages/desktop/src-tauri/sidecars/unifia-cli-<rust-target>, which is where
# tauri.conf.json's externalBin resolves, populated by scripts/predev.ts). The
# ~185 MB exe cached here is a build artefact, not a source.
packages/desktop/sidecars/

# gstack local reports and analytics
.gstack/

# graphify dependency graph cache (machine-generated, not for version control)
graphify-out/

# Claude Code local memory (project-specific, not for version control)
.claude/

# Dev/sprint logs (test, build, typecheck) — generated by automation, never tracked
*.log

# Agent workspace + runtime smoke logs (machine-local, never tracked)
.mavis/
.smoke/

# CI/debug investigation scratch (gh api dumps, ps1 scripts, logs) — machine-local
_bench/

# Unifia brand backup (auto-generated by install-brand.mjs, do not commit)
.unifia-brand-backup/

# Transient bundles produced by the generative-ui-dom browser e2e runner
.e2e-build/

# Local output of scripts/unifia-conformance.mjs --json
unifia-conformance.json

# Local scratch archive (PR body drafts, migration notes) — never tracked
.unifia-archives/

# Release build outputs: android-runtime-provenance.json records the absolute
# repository path and per-machine tool versions, so it is a local record rather
# than something to track.
artifacts/
packages/mobile/src-tauri/ort-runtime/

# Workbench runtime state (.unifia/workspace.json, audit logs) — local
# record of the bridge between the Workbench sidecar and the Solid
# surface, never tracked.
.unifia/

# Playwright / vitest results produced by `bun test --reporter=junit`
# (or the conformance runner); safe to regenerate, not versionable.
test-results/

# Ad-hoc debug script kept around for the next time the flaky-test
# investigation needs it. Rename or move under scripts/ if it earns
# a permanent home.
debug-flaky.mjs

# Native-side sidecar test artifacts: the .err is the captured stderr
# of a manual run, the .mjs is a one-off browser harness not yet
# promoted to the proper test entrypoint. Both stay local until a
# dedicated test contract lands.
packages/desktop/sidecar-test.err
packages/workbench-server/test/real-transport-browser.mjs
