{
  "name": "@unifia/app",
  "version": "1.3.15",
  "description": "",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.js",
    "./index.css": "./src/index.css",
    "./hooks/speech-tauri-adapter": "./src/hooks/speech-tauri-adapter.ts"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "bun run test:unit",
    "test:ci": "mkdir -p .artifacts/unit && bun test --timeout 30000 --preload ./happydom.ts ./src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml",
    "test:unit": "bun test --preload ./happydom.ts ./src",
    "test:unit:watch": "bun test --watch --preload ./happydom.ts ./src",
    "test:e2e": "playwright test",
    "test:e2e:local": "bun script/e2e-local.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "parity:environment:check": "bun run scripts/parity/environment-check.ts",
    "parity:contract": "bun run scripts/parity/contract.ts",
    "parity:path-classification:check": "bun run scripts/parity/path-classification-check.ts",
    "parity:path-classification:coverage": "bun run scripts/parity/path-classification-check.ts",
    "parity:generated:verify": "bun run scripts/parity/generated-verify.ts",
    "parity:checkpoint:lint": "bun run scripts/parity/checkpoint-lint.ts",
    "parity:g0-mode:derive": "bun run scripts/parity/g0-mode-derive.ts",
    "parity:g0-mode:check": "bun run scripts/parity/g0-mode-derive.ts",
    "parity:census": "bun run scripts/parity/runtime.ts census",
    "parity:aa": "bun run scripts/parity/runtime.ts aa",
    "parity:aa-prime": "bun run scripts/parity/runtime.ts aa-prime",
    "parity:visual": "bun run scripts/parity/runtime.ts visual",
    "parity:motion": "bun run scripts/parity/runtime.ts motion",
    "parity:mutations": "bun run scripts/parity/runtime.ts mutations",
    "parity:g3": "bun run scripts/parity/runtime.ts g3",
    "parity:full": "bun run scripts/parity/runtime.ts full"
  },
  "license": "MIT",
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "1.57.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
