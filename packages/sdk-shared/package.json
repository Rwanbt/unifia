{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@unifia/sdk-shared",
  "version": "1.3.15",
  "description": "Shared Unifia SDK surface — re-exports the v2 client alongside the structural model aliases (Session, Message, Part, Provider, ...).",
  "keywords": [
    "unifia",
    "sdk",
    "types",
    "ai",
    "agent",
    "typescript"
  ],
  "homepage": "https://github.com/Rwanbt/unifia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rwanbt/unifia.git",
    "directory": "packages/sdk-shared"
  },
  "bugs": {
    "url": "https://github.com/Rwanbt/unifia/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types/*": "./src/types/*.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "compile": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "build": "bun run compile"
  },
  "dependencies": {
    "@unifia/sdk": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
