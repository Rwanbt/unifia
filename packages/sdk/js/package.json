{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@unifia/sdk",
  "version": "1.3.15",
  "description": "TypeScript client for the Unifia server API — typed HTTP client, server bindings and generated route types.",
  "keywords": [
    "unifia",
    "sdk",
    "api-client",
    "ai",
    "agent",
    "typescript"
  ],
  "homepage": "https://github.com/Rwanbt/unifia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rwanbt/unifia.git",
    "directory": "packages/sdk/js"
  },
  "bugs": {
    "url": "https://github.com/Rwanbt/unifia/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "compile": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/server": "./src/v2/server.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}
