<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the Linux packages this fork builds.

  It described the upstream project verbatim — id ai.opencode.opencode, name
  OpenCode, upstream URLs and upstream's release history — so a .deb or .rpm
  produced here registered itself with the desktop as OpenCode. Two installs
  would have claimed the same AppStream component.

  Upstream attribution is a licence obligation and lives in LICENSE and in the
  description below; it does not belong in the component identity.
-->
<component type="desktop-application">
  <id>ai.unifia.desktop</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Unifia</name>
  <summary>Open source AI coding agent</summary>

  <developer id="dev.unifia">
    <name>Rwanbt</name>
  </developer>

  <description>
    <p>
      Unifia is an open source agent that helps you write and run code with any AI model.
    </p>
    <p>
      Unifia is a fork of OpenCode by Anomaly Innovations Inc., used under the MIT licence.
      It is not affiliated with or endorsed by that project.
    </p>
  </description>

  <launchable type="desktop-id">ai.unifia.desktop.desktop</launchable>

  <content_rating type="oars-1.1" />

  <url type="bugtracker">https://github.com/Rwanbt/opencode/issues</url>
  <url type="vcs-browser">https://github.com/Rwanbt/opencode</url>

  <!--
    No homepage or screenshot url: the previous ones pointed at opencode.ai,
    a domain this fork does not control, and per decision D15 nothing is
    announced before there is proof of control over it.

    No <releases> block either. It carried upstream's 1.0.2xx history with
    links to upstream tags, which is not this product's release record.
  -->
</component>
