{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "unifia-workbench",
  "description": "Unifia Workbench — AI-powered development environment (fork of Rwanbt/unifia)",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run --cwd packages/unifia --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop tauri dev",
    "dev:web": "bun --cwd packages/app dev",
    "dev:console": "ulimit -n 10240 2>/dev/null; bun run --cwd packages/console/app dev",
    "dev:mobile-android": "bun --cwd packages/mobile tauri android dev",
    "dev:mobile-ios": "bun --cwd packages/mobile tauri ios dev",
    "dev:storybook": "bun --cwd packages/storybook storybook",
    "typecheck": "bun turbo typecheck",
    "brand:generate": "node scripts/brand/generate.mjs",
    "brand:check": "node scripts/brand/check.mjs",
    "identity:generate": "node scripts/identity/generate.mjs",
    "identity:check": "node scripts/identity/check.mjs",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check . --write",
    "deadcode": "bunx knip --no-progress",
    "test:ai": "bun turbo typecheck",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1",
    "test:unifia": "cd packages/unifia && bun test",
    "test:session": "cd packages/unifia && bun test --filter session"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "!packages/enterprise",
      "packages/console/*",
      "packages/sdk/js",
      "packages/slack"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.0-beta.43",
      "@types/bun": "1.3.11",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.1.0-beta.18",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.3",
      "drizzle-kit": "1.0.0-beta.19-d95b7a4",
      "drizzle-orm": "1.0.0-beta.19-d95b7a4",
      "effect": "4.0.0-beta.43",
      "ai": "6.0.138",
      "cross-spawn": "7.0.6",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.42.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
        "@solidjs/router": "0.15.4",
        "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@biomejs/biome": "2.4.14",
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "knip": "6.12.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "sst": "3.18.10",
    "turbo": "2.8.13"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@unifia/plugin": "workspace:*",
    "@unifia/script": "workspace:*",
    "@unifia/sdk": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rwanbt/unifia"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "@effect/platform-node-shared": "4.0.0-beta.43",
    "fastify": "5.8.5",
    "diff": "8.0.3",
    "minimatch": "10.2.5",
    "axios": "1.16.0",
    "follow-redirects": "1.16.0",
    "postcss": "8.5.14",
    "uuid": "13.0.1",
    "defu": "6.1.7",
    "seroval": "1.5.4",
    "react-router": "6.30.2",
    "wrangler": "4.89.1",
    "ip-address": "10.2.0",
